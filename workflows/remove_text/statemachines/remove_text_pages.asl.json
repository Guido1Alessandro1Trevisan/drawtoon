{
  "Comment": "Remove text from Drawtoon filtered manga pages with Qwen Image Edit 2511 through a Step Functions Distributed Map.",
  "StartAt": "PrepareConfig",
  "States": {
    "PrepareConfig": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PrepareRemoveTextConfigArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.prepared",
      "OutputPath": "$.prepared.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "RemoveTextPages"
    },
    "RemoveTextPages": {
      "Type": "Map",
      "Label": "RemoveTextPages",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "Parameters": {
          "Bucket.$": "$.source.bucket",
          "Key.$": "$.source.manifest_key"
        },
        "ReaderConfig": {
          "InputType": "JSONL"
        }
      },
      "ItemSelector": {
        "row_index.$": "$$.Map.Item.Index",
        "page.$": "$$.Map.Item.Value",
        "config_ref": {
          "bucket.$": "$.worker_config.bucket",
          "key.$": "$.worker_config.key"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "RemoveTextPage",
        "States": {
          "RemoveTextPage": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${RemoveTextPageArn}",
              "Payload.$": "$"
            },
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.TooManyRequestsException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "OutputPath": "$.Payload",
            "End": true
          }
        }
      },
      "MaxConcurrencyPath": "$.batch.max_concurrency",
      "ToleratedFailureCountPath": "$.failure.tolerated_failure_count",
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket.$": "$.audit.bucket",
          "Prefix.$": "$.audit.prefix"
        },
        "WriterConfig": {
          "OutputType": "JSONL",
          "Transformation": "COMPACT"
        }
      },
      "ResultPath": "$.map_result",
      "End": true
    }
  }
}
