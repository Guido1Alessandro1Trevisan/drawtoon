{
  "Comment": "Caption Drawtoon filtered manga pages with page-level fanout. This temporary fast path drops sequential chapter memory so concurrency applies to pages.",
  "StartAt": "PrepareConfig",
  "States": {
    "PrepareConfig": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PrepareMangaCaptionConfigArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.prepared",
      "OutputPath": "$.prepared.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "CaptionPages"
    },
    "CaptionPages": {
      "Type": "Map",
      "Label": "CaptionPages",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "Parameters": {
          "Bucket.$": "$.source.bucket",
          "Key.$": "$.source.page_manifest_key"
        },
        "ReaderConfig": {
          "InputType": "JSONL"
        }
      },
      "ItemSelector": {
        "row_index.$": "$$.Map.Item.Index",
        "chapter.$": "$$.Map.Item.Value.chapter",
        "pages_key.$": "$$.Map.Item.Value.pages_key",
        "page_count.$": "$$.Map.Item.Value.page_count",
        "next_page_index.$": "$$.Map.Item.Value.page_index",
        "memory": {},
        "counts": {
          "ok": 0,
          "skipped_existing": 0,
          "error": 0
        },
        "done": false,
        "config_ref": {
          "bucket.$": "$.worker_config.bucket",
          "key.$": "$.worker_config.key"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "CaptionPage",
        "States": {
          "CaptionPage": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${CaptionMangaPageArn}",
              "Payload.$": "$"
            },
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.TooManyRequestsException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "OutputPath": "$.Payload",
            "End": true
          }
        }
      },
      "MaxConcurrencyPath": "$.batch.max_concurrency",
      "ToleratedFailureCountPath": "$.failure.tolerated_failure_count",
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket.$": "$.audit.bucket",
          "Prefix.$": "$.audit.prefix"
        },
        "WriterConfig": {
          "OutputType": "JSONL",
          "Transformation": "COMPACT"
        }
      },
      "ResultPath": "$.map_result",
      "End": true
    }
  }
}
