FROM python:3.11-slim

ENV HF_HOME=/root/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/root/.cache/huggingface/hub \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    NO_ALBUMENTATIONS_UPDATE=1 \
    DISABLE_TELEMETRY=YES \
    PYTHONPATH=/root/ai-toolkit

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    git \
    rsync \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root

# Dependency layer: only invalidates when the requirements files change.
COPY lora-klein/ai-toolkit/requirements.txt /tmp/ai-toolkit/requirements.txt
COPY lora-klein/ai-toolkit/requirements_base.txt /tmp/ai-toolkit/requirements_base.txt

RUN pip install --no-cache-dir \
    torch==2.9.1 \
    torchvision==0.24.1 \
    torchaudio==2.9.1 \
    --index-url https://download.pytorch.org/whl/cu128

RUN cd /tmp/ai-toolkit && pip install -r requirements.txt
RUN pip install --no-cache-dir psycopg2-binary pyyaml awscli boto3
